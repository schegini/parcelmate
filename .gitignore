# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore environment
.venv
.env
venv/

# Ignore test output files
reports/
tests/*/*.txt
results_knockout_test/

# Ignore macOS directory metadata
.DS_Store

# Stray SLURM job logs written to the repo root. Root-anchored so the run logs
# tracked under parcelmate/c_outputs/*/sweep/logs/ are unaffected.
/*.out

# Local copies of cluster results pulled down for inspection. Root-anchored so
# the curated outputs under parcelmate/c_outputs/sweeps/ stay tracked.
/sweeps/
/results-bundle.tgz
/sweep_nnetworks/

# Generated plots. These are regenerable from the h5 outputs on scratch, and
# the connectivity heatmaps alone run to ~1GB. The knockout bar plots are the
# figures we actually share, so they stay tracked; force-add anything else
# worth keeping with `git add -f`.
**/plots/*
!**/plots/knockout/

# Working run log. Kept local and deliberately untracked: it carries in-progress
# interpretations, retracted findings, and open threads that should not be
# published from this repo. Note that ignoring it does not remove it from the
# history of commits that already contain it.
parcelmate/c_outputs/FINDINGS.md