#!/bin/bash
#
#SBATCH --job-name=original_match_iter2
#SBATCH --output="original_match_iter2-%N-%j.out"
#SBATCH --time=10:00:00
#SBATCH --mem=24G
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --account=nlp
#SBATCH --partition=sphinx

# Runs the ORIGINAL (upstream) parcelmate on settings matched to the fork's
# iteration 2, so the two can be compared. Submit it FROM the original/ dir:
#
#     cd ~/parcelmate/original && sbatch jobs/match_iter2.pbs
#
# Hand-written rather than generated: the original's make_jobs.py predates the
# home-quota redirects and the uv bootstrap below, so a .pbs generated by it
# would write the HF cache into the 20GB /sailhome quota and fail (see
# CLUSTER.md). Everything below the cd is byte-identical to what the fork's
# make_jobs.py emits.

set -e

# Run from the ORIGINAL package dir. This is what makes `python -m parcelmate...`
# resolve to original/parcelmate rather than the fork's package one level up --
# cwd precedes everything else on sys.path. Getting this wrong silently runs the
# FORK's code and the whole comparison is void, so it is asserted below.
cd "${SLURM_SUBMIT_DIR:-$HOME/parcelmate/original}"

# Keep caches + venv off the /sailhome home quota (see CLUSTER.md).
export HF_HOME=/nlp/scr/schegini/.cache/huggingface
export UV_CACHE_DIR=/nlp/scr/schegini/.cache/uv
export UV_PROJECT_ENVIRONMENT=/nlp/scr/schegini/parcelmate/venvs/original_match_iter2
mkdir -p /nlp/scr/schegini/.cache /nlp/scr/schegini/parcelmate/venvs

if ! command -v uv &> /dev/null; then
    if [ -x "$HOME/.local/bin/uv" ]; then
        export PATH="$HOME/.local/bin:$PATH"
    else
        curl -LsSf https://astral.sh/uv/install.sh | sh
        export PATH="$HOME/.local/bin:$PATH"
    fi
fi

uv sync

# Fail loudly if we somehow imported the fork's package instead of this one.
uv run python -c "
import os, parcelmate
here = os.path.dirname(os.path.abspath(parcelmate.__file__))
want = os.path.join(os.getcwd(), 'parcelmate')
assert here == want, 'Imported the WRONG parcelmate: %s (wanted %s)' % (here, want)
print('Using original parcelmate at', here)
"

# Note there is no size-matched random baseline here: this is the original's
# knockout plus the three additions, not the fork's selectivity analysis.
uv run python -m parcelmate.bin.main configs/match_iter2.yaml \
    -s connectivity parcellation subnetwork_extraction \
       plot_connectivity plot_parcellation plot_stability \
       subnetwork_knockout
